   "source": [
    "n = int(input())\n",
    "teams = []\n",
    "for i in range(n):\n",
    "    h, a = map(int, input().split())\n",
    "    teams.append((h, a))\n",
    "\n",
    "count = 0\n",
    "for j in range(n):\n",
    "    for k in range(n):\n",
    "        if j != k:\n",
    "            if teams[j][0] == teams[k][1]:\n",
    "                count += 1\n",
    "\n",
    "print(count)\n"
   ]
  }
